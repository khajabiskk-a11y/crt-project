# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_PATH=./data/analyzer.db
UPLOAD_DIR=./data/uploads

# Firebase Authentication (Optional: If not set, system supports Interactive Demo/Dev Mode & Client-Configured Auth)
FIREBASE_PROJECT_ID=requirement-analyzer-demo
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=requirement-analyzer-demo.firebaseapp.com
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=

# AI Provider Configuration: local | openai | gemini | claude | ollama
# Default is 'local' which uses the smart built-in semantic NLP logic engine (no external API keys needed!)
AI_PROVIDER=local

# External AI Provider Keys (Optional: set these to use cloud models)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
